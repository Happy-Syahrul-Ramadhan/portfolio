generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Project {
  id          String   @id @default(uuid()) @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  title       String
  description String
  content     String?
  imageUrl    String?  @map("image_url")
  link        String?
  published   Boolean  @default(false)
  slug        String   @unique @default("")
  hashtags    String?

  @@map("projects")
}

model Blog {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  title     String
  excerpt   String
  content   String
  slug      String   @unique
  published Boolean  @default(false)
  imageUrl  String?  @map("image_url")
  hashtags  String?

  @@map("blogs")
}

model Admin {
  id        String   @id @default(uuid()) @db.Uuid
  username  String   @unique
  password  String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("admins")
}

model Profile {
  id        String  @id @default("singleton")
  name      String  @default("")
  title     String  @default("")
  bio       String  @default("")
  location  String  @default("")
  email     String  @default("")
  avatarUrl String? @map("avatar_url")
  github    String  @default("")
  linkedin  String  @default("")
  googleScholar String  @default("") @map("google_scholar")
  website   String  @default("")
  cvUrl     String? @map("cv_url")

  @@map("profile")
}

model WorkExperience {
  id          String   @id @default(uuid()) @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  company     String
  role        String
  period      String
  description String
  logoUrl     String?  @map("logo_url")
  current     Boolean  @default(false)
  order       Int      @default(0)
  skills      String?

  @@map("work_experiences")
}

model Certificate {
  id            String    @id @default(uuid()) @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  title         String
  description   String
  imageUrl      String    @map("image_url")
  issuer        String?
  issueDate     DateTime? @map("issue_date")
  credentialUrl String?   @map("credential_url")
  published     Boolean   @default(false)
  order         Int       @default(0)
  credentialId  String?   @map("credential_id")
  skills        String?

  @@map("certificates")
}

model Publication {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  title     String
  authors   String
  journal   String
  volume    String?
  year      Int
  doi       String?
  url       String?
  abstract  String?
  order     Int      @default(0)
  published Boolean  @default(true)

  @@map("publications")
}

model IntellectualProperty {
  id             String   @id @default(uuid()) @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  registrationNo String   @map("registration_no")
  title          String
  description    String?
  type           String   @default("Hak Cipta")
  year           Int
  issuer         String   @default("Kemenkumham RI")
  url            String?
  order          Int      @default(0)

  @@map("intellectual_properties")
}
